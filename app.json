{
  "expo": {
    "scheme": "sinkplane",
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "androidTVBanner": "./assets/tv_icons/banner-320x180.png",
          "appleTVImages": {
            "iconLayers": {
              "front": "./assets/tv_icons/icon-1280x768-front.png",
              "middle": "./assets/tv_icons/icon-1280x768-middle.png",
              "back": "./assets/tv_icons/icon-1280x768-back.png"
            },
            "iconSmallLayers": {
              "front": "./assets/tv_icons/icon-400x240-front.png",
              "middle": "./assets/tv_icons/icon-400x240-middle.png",
              "back": "./assets/tv_icons/icon-400x240-back.png"
            },
            "iconSmall2xLayers": {
              "front": "./assets/tv_icons/icon-800x480-front.png",
              "middle": "./assets/tv_icons/icon-800x480-middle.png",
              "back": "./assets/tv_icons/icon-800x480-back.png"
            },
            "topShelf": "./assets/tv_icons/top-shelf-1920x720.png",
            "topShelf2x": "./assets/tv_icons/top-shelf-3840x1440.png",
            "topShelfWide": "./assets/tv_icons/top-shelf-2320x720.png",
            "topShelfWide2x": "./assets/tv_icons/top-shelf-4640x1440.png"
          }
        }
      ],
      "./plugins/with-tv-scene-lifecycle",
      "expo-router",
      "expo-font",
      "expo-build-properties",
      "expo-web-browser",
      "expo-secure-store",
      "react-native-video"
    ],
    "icon": "./assets/images/icon.png",
    "android": {
      "edgeToEdgeEnabled": true,
      "splash": {
        "image": "./assets/images/splash.png"
      },
      "package": "com.sinkplane.sinkplanetv",
      "permissions": ["android.permission.ACCESS_NETWORK_STATE", "android.permission.INTERNET"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#1B3480"
      }
    },
    "ios": {
      "splash": {
        "image": "./assets/images/splash.png"
      },
      "bundleIdentifier": "com.sinkplane.sinkplanetv",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "newArchEnabled": true,
    "name": "Sinkplane TV",
    "slug": "sinkplane-tv",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "19a557e6-6d1d-4e7a-a642-cd45ee39124d"
      }
    },
    "owner": "sinkplane"
  }
}
