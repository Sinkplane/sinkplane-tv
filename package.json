{
  "name": "sinkplane",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "android": "EXPO_TV=1 expo run:android",
    "ios": "EXPO_TV=1 expo run:ios",
    "web": "expo start --web",
    "lint": "make lint",
    "test": "make test acceptance",
    "test:watch": "jest -c jest.config.unit.js --watch",
    "check": "make check",
    "prebuild": "expo prebuild --clean",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --clean",
    "deploy": "expo export -p web && pnpm dlx eas-cli@latest deploy",
    "link:shared": "./scripts/link-shared-dist.sh",
    "unlink:shared": "./scripts/link-shared-dist.sh --unlink",
    "eas-build-pre-install": "node scripts/eas-npmrc-auth.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@preeternal/react-native-cookie-manager": "^7.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sinkplane/shared": "^0.1.3",
    "@tanstack/react-query": "^5.104.2",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.3-0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-video": "^6.19.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-native-zeroconf": "^0.17.4"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.30.1",
    "@eslint/js": "10.0.1",
    "@react-native-tvos/config-tv": "^0.1.7",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/jest-runner": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "~19.2.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.18.0",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.14.0",
    "jest": "^30.5.2",
    "jest-expo": "~57.0.6",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1"
