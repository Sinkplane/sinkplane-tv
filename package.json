{
  "name": "sinkplane",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "android": "EXPO_TV=1 expo run:android",
    "ios": "EXPO_TV=1 expo run:ios",
    "web": "expo start --web",
    "reset-project": "./scripts/reset-project.js",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --silent --coverage",
    "prebuild": "expo prebuild --clean",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --clean",
    "deploy": "expo export -p web && pnpm dlx eas-cli@latest deploy",
    "postinstall": "patch-package",
    "prepare": "husky",
    "link:shared": "./scripts/link-shared-dist.sh",
    "unlink:shared": "./scripts/link-shared-dist.sh --unlink"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@mux/mux-data-react-native-video": "^0.19.21",
    "@preeternal/react-native-cookie-manager": "^7.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sinkplane/shared": "^0.1.1",
    "@tanstack/react-query": "^5.104.2",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.3-0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-network-info": "^5.2.2",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-video": "^6.19.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-native-zeroconf": "^0.17.4",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@react-native-tvos/config-tv": "^0.1.7",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.0",
    "@types/react-native-zeroconf": "^0.13.1",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "~57.0.6",
    "lint-staged": "^16.2.4",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "expo lint --fix"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  },
  "private": true
}
