+        if let _playerViewController {
+            applyPlaybackSpeeds(to: _playerViewController)
+        }
+    }
+
+    func applyPlaybackSpeeds(to viewController: AVPlayerViewController) {
+        guard #available(iOS 16.0, tvOS 16.0, *) else { return }
+
+        if let rates = _playbackSpeeds, !rates.isEmpty {
+            let formatter = NumberFormatter()
+            formatter.minimumFractionDigits = 0
+            formatter.maximumFractionDigits = 2
+            viewController.speeds = rates.map { rate in
+                let label = formatter.string(from: NSNumber(value: rate)) ?? "\(rate)"
+                return AVPlaybackSpeed(rate: rate, localizedName: "\(label)×")
+            }
+        } else {
+            viewController.speeds = AVPlaybackSpeed.systemDefaultSpeeds
+        }
+
+        if let initialSpeed = viewController.speeds.first(where: { $0.rate == _rate }) {
+            viewController.selectSpeed(initialSpeed)
+        }
