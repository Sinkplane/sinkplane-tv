@@ -0,0 +1,404 @@
+import AVFoundation
+import AVKit
+import UIKit
+
+// MARK: - CaptionTrack
+
+/// A WebVTT caption file loaded outside of the stream, for HLS sources where `textTracks` can't be side-loaded.
+struct CaptionTrack: Equatable {
+    let id: String
+    let uri: String
+    let title: String?
+    let language: String?
+    let subtitle: String?
+    let headers: [String: String]
+
+    init?(_ dict: NSDictionary) {
+        guard let id = dict["id"] as? String,
+              let uri = dict["uri"] as? String, !uri.isEmpty else { return nil }
+
+        self.id = id
+        self.uri = uri
+        self.title = dict["title"] as? String
+        self.language = dict["language"] as? String
+        self.subtitle = dict["subtitle"] as? String
+
+        var headers: [String: String] = [:]
+        for header in dict["headers"] as? [NSDictionary] ?? [] {
+            if let key = header["key"] as? String, let value = header["value"] as? String {
+                headers[key] = value
+            }
+        }
+        self.headers = headers
+    }
+
+    var displayName: String {
+        if let title, !title.isEmpty { return title }
+        if let language, !language.isEmpty {
+            return Locale.current.localizedString(forIdentifier: language)?.capitalized(with: Locale.current) ?? language
+        }
+        return "Subtitles"
+    }
+
+    var menuIdentity: [String?] {
+        [id, displayName, subtitle]
+    }
+}
+
+// MARK: - WebVTT
+
+struct CaptionCue {
+    let start: Double
+    let end: Double
+    let text: String
+}
+
+enum WebVTTParser {
+    static func parse(_ contents: String) -> [CaptionCue] {
+        let normalized = contents
+            .replacingOccurrences(of: "\r\n", with: "\n")
+            .replacingOccurrences(of: "\r", with: "\n")
+
+        var cues: [CaptionCue] = []
+        var block: [String] = []
+        for line in normalized.components(separatedBy: "\n") + [""] {
+            if line.trimmingCharacters(in: .whitespaces).isEmpty {
+                if let cue = parseBlock(block) {
+                    cues.append(cue)
+                }
+                block.removeAll()
+            } else {
+                block.append(line)
+            }
+        }
+        return cues.sorted { $0.start < $1.start }
+    }
+
+    private static func parseBlock(_ lines: [String]) -> CaptionCue? {
+        guard let timingIndex = lines.firstIndex(where: { $0.contains("-->") }) else { return nil }
+
+        let timing = lines[timingIndex].components(separatedBy: "-->")
+        guard timing.count == 2,
+              let start = parseTimestamp(timing[0]),
+              let endToken = timing[1].split(whereSeparator: { $0 == " " || $0 == "\t" }).first,
+              let end = parseTimestamp(String(endToken)),
+              end > start else { return nil }
+
+        let text = lines[(timingIndex + 1)...]
+            .map(cleanText)
+            .joined(separator: "\n")
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+        return text.isEmpty ? nil : CaptionCue(start: start, end: end, text: text)
+    }
+
+    /// Accepts `hh:mm:ss.ttt` and `mm:ss.ttt`.
+    private static func parseTimestamp(_ raw: String) -> Double? {
+        let parts = raw
+            .trimmingCharacters(in: .whitespaces)
+            .replacingOccurrences(of: ",", with: ".")
+            .split(separator: ":")
+        guard (2 ... 3).contains(parts.count), let seconds = Double(parts[parts.count - 1]) else { return nil }
+
+        var total = seconds
+        var multiplier = 60.0
+        for part in parts.dropLast().reversed() {
+            guard let value = Double(part) else { return nil }
+            total += value * multiplier
+            multiplier *= 60
+        }
+        return total
+    }
+
+    private static func cleanText(_ line: String) -> String {
+        line
+            .replacingOccurrences(of: "<[^>]*>", with: "", options: .regularExpression)
+            .replacingOccurrences(of: "&lt;", with: "<")
+            .replacingOccurrences(of: "&gt;", with: ">")
+            .replacingOccurrences(of: "&nbsp;", with: " ")
+            .replacingOccurrences(of: "&lrm;", with: "")
+            .replacingOccurrences(of: "&rlm;", with: "")
+            .replacingOccurrences(of: "&amp;", with: "&")
+    }
+}
+
+// MARK: - CaptionOverlayView
+
+final class CaptionOverlayView: UIView {
+    private let backdrop = UIView()
+    private let label = UILabel()
+    private var bottomConstraint: NSLayoutConstraint!
+    private var labelInsetConstraints: [NSLayoutConstraint] = []
+    private var raised = false
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        isUserInteractionEnabled = false
+        autoresizingMask = [.flexibleWidth, .flexibleHeight]
+
+        backdrop.translatesAutoresizingMaskIntoConstraints = false
+        backdrop.backgroundColor = UIColor.black.withAlphaComponent(0.6)
+        backdrop.layer.cornerRadius = 8
+        backdrop.isHidden = true
+
+        label.translatesAutoresizingMaskIntoConstraints = false
+        label.numberOfLines = 0
+        label.textAlignment = .center
+        label.textColor = .white
+
+        addSubview(backdrop)
+        backdrop.addSubview(label)
+
+        bottomConstraint = backdrop.bottomAnchor.constraint(equalTo: bottomAnchor)
+        labelInsetConstraints = [
+            label.leadingAnchor.constraint(equalTo: backdrop.leadingAnchor),
+            backdrop.trailingAnchor.constraint(equalTo: label.trailingAnchor),
+            label.topAnchor.constraint(equalTo: backdrop.topAnchor),
+            backdrop.bottomAnchor.constraint(equalTo: label.bottomAnchor),
+        ]
+        NSLayoutConstraint.activate(labelInsetConstraints + [
+            bottomConstraint,
+            backdrop.centerXAnchor.constraint(equalTo: centerXAnchor),
+            backdrop.widthAnchor.constraint(lessThanOrEqualTo: widthAnchor, multiplier: 0.8),
+        ])
+    }
+
+    @available(*, unavailable)
+    required init?(coder _: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    func setText(_ text: String?) {
+        guard label.text != text else { return }
+        label.text = text
+        backdrop.isHidden = text == nil
+    }
+
+    /// Lifts captions above the transport bar while it's on screen.
+    func setRaised(_ raised: Bool) {
+        self.raised = raised
+        updateMetrics()
+        layoutIfNeeded()
+    }
+
+    override func layoutSubviews() {
+        updateMetrics()
+        super.layoutSubviews()
+    }
+
+    private func updateMetrics() {
+        let height = bounds.height
+        guard height > 0 else { return }
+
+        let fontSize = (height * 0.04).rounded()
+        if label.font.pointSize != fontSize {
+            label.font = .systemFont(ofSize: fontSize, weight: .medium)
+        }
+
+        let horizontalPadding = (fontSize * 0.5).rounded()
+        let verticalPadding = (fontSize * 0.2).rounded()
+        for constraint in labelInsetConstraints {
+            let isHorizontal = constraint.firstAttribute == .leading || constraint.firstAttribute == .trailing
+            constraint.constant = isHorizontal ? horizontalPadding : verticalPadding
+        }
+
+        bottomConstraint.constant = -(height * (raised ? 0.3 : 0.08)).rounded()
+    }
+}
