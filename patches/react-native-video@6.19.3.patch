+// MARK: - RCTVideoCaptions
+
+/// Renders side-loaded WebVTT captions over `AVPlayerViewController` content and, on tvOS,
+/// exposes a "Subtitles" menu in the transport bar beside the playback speed control.
+///
+/// Tracks are fetched as soon as they're set: caption URLs may be short-lived signed URLs.
+final class RCTVideoCaptions {
+    private var tracks: [CaptionTrack] = []
+    private var selectedTrackId: String?
+    private var cuesByTrackId: [String: [CaptionCue]] = [:]
+    private var loadTasks: [String: URLSessionDataTask] = [:]
+    private let overlay = CaptionOverlayView()
+
+    private weak var playerViewController: AVPlayerViewController?
+    private weak var player: AVPlayer?
+    private var timeObserver: Any?
+
+    /// Called only for selections made in the transport bar menu.
+    var onUserSelection: ((String?) -> Void)?
+
+    private var selectedCues: [CaptionCue] {
+        selectedTrackId.flatMap { cuesByTrackId[$0] } ?? []
+    }
+
+    deinit {
+        loadTasks.values.forEach { $0.cancel() }
+        removeTimeObserver()
+        overlay.removeFromSuperview()
+    }
+
+    func setTracks(_ newTracks: [CaptionTrack]) {
+        guard newTracks != tracks else { return }
+
+        let menuChanged = newTracks.map(\.menuIdentity) != tracks.map(\.menuIdentity)
+        tracks = newTracks
+
+        let trackIds = Set(tracks.map(\.id))
+        for (id, task) in loadTasks where !trackIds.contains(id) {
+            task.cancel()
+            loadTasks[id] = nil
+        }
+        cuesByTrackId = cuesByTrackId.filter { trackIds.contains($0.key) }
+        tracks.forEach(load)
+
+        if menuChanged {
+            updateMenu()
+        }
+    }
+
+    func attach(to viewController: AVPlayerViewController, player: AVPlayer) {
+        removeTimeObserver()
+        playerViewController = viewController
+        self.player = player
+
+        if let contentOverlayView = viewController.contentOverlayView {
+            overlay.frame = contentOverlayView.bounds
+            contentOverlayView.addSubview(overlay)
+        }
+
+        updateMenu()
+        if !selectedCues.isEmpty {
+            addTimeObserver()
+        }
+    }
+
+    func setTransportBarVisible(_ visible: Bool) {
+        overlay.setRaised(visible)
+    }
+
+    /// The selected track may arrive before `setTracks`; it's applied once that track loads.
+    func setSelectedTrackId(_ trackId: String?) {
+        guard trackId != selectedTrackId else { return }
+        select(trackId)
+        updateMenu()
+    }
+
+    private func userSelect(_ trackId: String?) {
+        guard trackId != selectedTrackId else { return }
+        select(trackId)
+        onUserSelection?(trackId)
+    }
+
+    private func select(_ trackId: String?) {
+        guard trackId != selectedTrackId else { return }
+
+        removeTimeObserver()
+        overlay.setText(nil)
+        selectedTrackId = trackId
+
+        guard let trackId else { return }
+        if cuesByTrackId[trackId] != nil {
+            addTimeObserver()
+        } else if let track = tracks.first(where: { $0.id == trackId }) {
+            load(track)
+        }
+    }
+
+    private func load(_ track: CaptionTrack) {
+        guard cuesByTrackId[track.id] == nil, loadTasks[track.id] == nil else { return }
+        guard let url = URL(string: track.uri) else {
+            DebugLog("Invalid caption track URL: \(track.uri)")
+            return
+        }
+
+        var request = URLRequest(url: url)
+        for (key, value) in track.headers {
+            request.setValue(value, forHTTPHeaderField: key)
+        }
+
+        let task = URLSession.shared.dataTask(with: request) { [weak self] data, response, error in
+            DispatchQueue.main.async {
+                self?.handleLoad(trackId: track.id, data: data, response: response, error: error)
+            }
+        }
+        loadTasks[track.id] = task
+        task.resume()
+    }
+
+    private func handleLoad(trackId: String, data: Data?, response: URLResponse?, error: Error?) {
+        if (error as? URLError)?.code == .cancelled { return }
+        loadTasks[trackId] = nil
+        guard tracks.contains(where: { $0.id == trackId }) else { return }
+
+        let status = (response as? HTTPURLResponse)?.statusCode ?? 200
+        guard error == nil, (200 ..< 300).contains(status), let data,
+              let contents = String(data: data, encoding: .utf8) ?? String(data: data, encoding: .isoLatin1) else {
+            DebugLog("Failed to load caption track \(trackId): \(error?.localizedDescription ?? "HTTP \(status)")")
+            if selectedTrackId == trackId {
+                selectedTrackId = nil
+                updateMenu()
+            }
+            return
+        }
+
+        cuesByTrackId[trackId] = WebVTTParser.parse(contents)
+        if selectedTrackId == trackId {
+            addTimeObserver()
+        }
+    }
+
+    private func addTimeObserver() {
+        guard timeObserver == nil, let player else { return }
+
+        timeObserver = player.addPeriodicTimeObserver(forInterval: CMTime(value: 1, timescale: 10), queue: .main) { [weak self] time in
+            self?.render(at: time.seconds)
+        }
+        render(at: player.currentTime().seconds)
+    }
+
+    private func removeTimeObserver() {
+        if let timeObserver {
+            player?.removeTimeObserver(timeObserver)
+        }
+        timeObserver = nil
+    }
+
+    private func render(at seconds: Double) {
+        guard seconds.isFinite else { return }
+
+        let text = selectedCues
+            .filter { $0.start <= seconds && seconds < $0.end }
+            .map(\.text)
+            .joined(separator: "\n")
+        overlay.setText(text.isEmpty ? nil : text)
+    }
+
+    private func updateMenu() {
+        #if os(tvOS)
+            guard #available(tvOS 16.0, *), let playerViewController else { return }
+            guard !tracks.isEmpty else {
+                playerViewController.transportBarCustomMenuItems = []
+                return
+            }
+
+            let isOff = !tracks.contains { $0.id == selectedTrackId }
+            let off = UIAction(title: "Off", state: isOff ? .on : .off) { [weak self] _ in
+                self?.userSelect(nil)
+            }
+            let trackActions = tracks.map { track in
+                let action = UIAction(title: track.displayName, state: track.id == selectedTrackId ? .on : .off) { [weak self] _ in
+                    self?.userSelect(track.id)
+                }
+                action.subtitle = track.subtitle
+                return action
+            }
+
+            playerViewController.transportBarCustomMenuItems = [
+                UIMenu(
+                    title: "Subtitles",
+                    image: UIImage(systemName: "captions.bubble"),
+                    options: .singleSelection,
+                    children: [off] + trackActions
+                ),
+            ]
+        #endif
+    }
+}
