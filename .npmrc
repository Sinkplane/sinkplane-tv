# @sinkplane/* packages are published to GitHub Packages
# (sinkplane-shared publishes there on v* tags — see its publish workflow).
# pnpm v12 reads registry/auth config ONLY from .npmrc; all other pnpm
# settings live in pnpm-workspace.yaml.
@sinkplane:registry=https://npm.pkg.github.com

# EAS Build substitutes ${GITHUB_PACKAGES_TOKEN} in this file before
# installing (set it as an EAS build environment variable — a PAT with
# read:packages on the Sinkplane org). pnpm itself never expands ${...} in
# repository-controlled credentials; locally this line is ignored and the
# token is read from ~/.npmrc instead. Never commit a real token here.
//npm.pkg.github.com/:_authToken=${GITHUB_PACKAGES_TOKEN}
