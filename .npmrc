# @sinkplane/* packages are published to GitHub Packages
# (sinkplane-shared publishes there on v* tags — see its publish workflow).
# pnpm v12 reads registry/auth config ONLY from .npmrc; all other pnpm
# settings live in pnpm-workspace.yaml.
@sinkplane:registry=https://npm.pkg.github.com

# EAS Build workers run pnpm, which (like local pnpm) never expands ${...} in
# repository-controlled credentials — this line is ignored there too. The
# `eas-build-pre-install` npm script (scripts/eas-npmrc-auth.mjs) copies the
# GITHUB_PACKAGES_TOKEN EAS environment variable (a PAT with read:packages on
# the Sinkplane org) into the worker's user-level ~/.npmrc before install.
# Never commit a real token here.
//npm.pkg.github.com/:_authToken=${GITHUB_PACKAGES_TOKEN}
